"""
Snakemake workflow for the FULL telomere analysis + recombination pipeline.

Steps 0–9:   Read prep, anchor BLAST, splitting, trimming, Y prime analysis
Steps 10–13: New recombination analysis against day0 reference

All scripts are called from scripts/ (matching telomere_analysis_complete.sh).
All rules use the --cores value for thread count.

Run everything:
    snakemake -s Snakefile_recombination --cores N

Run only through Y prime analysis (steps 0–9):
    snakemake -s Snakefile_recombination through_y_prime_analysis --cores N

Run only recombination (steps 10–13, requires step 3 outputs to exist):
    snakemake -s Snakefile_recombination recombination_summary --cores N

Run a single chr end through recombination:
    snakemake -s Snakefile_recombination \
        results/{base}/recombination/{base}_chr4R_recombination_reads.tsv --cores N

Prerequisites for steps 10–13 (from create_ref.sh + label_regions.sh on day0 data):
  - results/{day0_base}/assembly_{strain}/assembly_{strain}_dorado_reference.fasta
  - results/{day0_base}/pretelomeric_labels/pretelomeric_regions_{strain}_simp.bed
  - references/extracted_yprimes_{strain}.fasta
  - references/pairings_for_spacers/{strain}_pairings/
  - references/pairings_for_x_element_ends/{strain}_pairings/
"""

import os

configfile: "config.yaml"

# ===========================================================================
# Variables
# ===========================================================================

BASE   = config["base_name"]
ANCHOR = config["anchor_set"]
INPUT_DIR = config["bam_dir"]
STRAIN = config.get("strain", BASE.split("_")[1] if "dorado_" in BASE else BASE.split("_")[0])

DAY0_BASE = config.get(
    "day0_base_name",
    f"dorado_{STRAIN}_day0_PromethION_no_tag_yes_rejection",
)

# --- Paths: steps 0–9 ---
FASTA_IN       = f"results/{BASE}/{BASE}.fasta"
BASE_DIR       = f"results/{BASE}"
CHR_ANCHOR_DIR = f"results/{BASE}/chr_anchor_included_individual_files"
Y_PRIME_BLAST_DIR       = f"results/{BASE}/y_prime_blast_results_from_chr_anchored_reads"
Y_PRIME_BLAST_PROBE_DIR = f"{Y_PRIME_BLAST_DIR}/probes"

# --- Paths: steps 10–13 ---
DAY0_REF       = f"results/{DAY0_BASE}/assembly_{STRAIN}/assembly_{STRAIN}_dorado_reference.fasta"
DAY0_BED       = f"results/{DAY0_BASE}/pretelomeric_labels/pretelomeric_regions_{STRAIN}_simp.bed"
Y_PRIME_LIB    = f"references/extracted_yprimes_{STRAIN}.fasta"
SPACER_LIB_DIR = f"references/pairings_for_spacers/{STRAIN}_pairings/"
X_ELEM_LIB_DIR = f"references/pairings_for_x_element_ends/{STRAIN}_pairings/"
RECOMB_DIR     = f"results/{BASE}/recombination"

# Chromosome ends
CHROMS     = [str(i) for i in range(1, 17)]
SIDES      = ["L", "R"]
CHROM_ENDS = [f"chr{c}{s}" for c in CHROMS for s in SIDES]

# Blast Y prime output uses "{num}{side}" (no "chr" prefix), matching shell script
BLAST_CS = [f"{c}{s}" for c in CHROMS for s in SIDES]

# ===========================================================================
# Input detection (Step 0)
# ===========================================================================

BAM_IN      = f"{INPUT_DIR}/{BASE}.bam"
FASTQ_INPUT = f"{INPUT_DIR}/{BASE}.fastq"

if not os.path.exists(FASTA_IN):
    bam_exists   = os.path.exists(BAM_IN)
    fastq_exists = os.path.exists(FASTQ_INPUT)

    if bam_exists:
        rule prep_from_bam:
            input:
                bam = BAM_IN
            output:
                fastq = f"results/{BASE}/{BASE}.fastq",
                fasta = FASTA_IN
            threads: workflow.cores
            shell:
                """
                mkdir -p results/{BASE}
                samtools fastq -@ {threads} -T '*' {input.bam} > {output.fastq}
                seqtk seq -A {output.fastq} > {output.fasta}
                """
    elif fastq_exists:
        rule prep_from_fastq:
            input:
                fastq = FASTQ_INPUT
            output:
                fastq = f"results/{BASE}/{BASE}.fastq",
                fasta = FASTA_IN
            shell:
                """
                mkdir -p results/{BASE}
                cp {input.fastq} {output.fastq}
                seqtk seq -A {output.fastq} > {output.fasta}
                """
    else:
        raise ValueError(
            f"No input file found! Expected either:\n"
            f"  - BAM file: {BAM_IN}\n"
            f"  - FASTQ file: {FASTQ_INPUT}\n"
            f"Please provide one of these input files."
        )

# ===========================================================================
# Top-level targets
# ===========================================================================

rule all:
    input:
        f"results/outputs/{BASE}_post_y_prime_probe.tsv",
        f"results/{BASE}/.combined_plot_done",
        f"{RECOMB_DIR}/{BASE}_recombination_summary.tsv"

rule through_y_prime_analysis:
    input:
        f"results/outputs/{BASE}_post_y_prime_probe.tsv",
        f"results/{BASE}/.combined_plot_done"

rule recombination_summary:
    input:
        f"{RECOMB_DIR}/{BASE}_recombination_summary.tsv"

rule recombination_all_chr_ends:
    input:
        expand(
            f"{RECOMB_DIR}/{BASE}_{{chr_end}}_features.tsv",
            chr_end=CHROM_ENDS,
        )

# ===========================================================================
# Step 0b: Index FASTA (needed by split_and_label)
# ===========================================================================

rule index_fasta:
    input:
        fasta = FASTA_IN
    output:
        fai = f"{FASTA_IN}.fai"
    shell:
        "samtools faidx {input.fasta}"

# ===========================================================================
# Step 1: BLAST for reads with anchors
# ===========================================================================

rule blast_anchors:
    input:
        query = FASTA_IN,
        db = config["references"]["anchors"]
    output:
        tsv = f"results/{BASE}/{BASE}_blasted_{ANCHOR}.tsv"
    threads: workflow.cores
    shell:
        """
        echo -e "read_id\\ttotal_read_length\\tread_bp_used_for_match\\tmatch_start_on_read\\tmatch_end_on_read\\tanchor_name\\ttotal_anchor_length\\tmatch_start_on_anchor\\tmatch_end_on_anchor\\tpident\\tbitscore\\tevalue" > {output.tsv}

        blastn -query {input.query} -db {input.db} -task dc-megablast \
            -perc_identity 85 -min_raw_gapped_score 3000 -num_threads {threads} \
            -outfmt "6 qseqid qlen length qstart qend sseqid slen sstart send pident bitscore evalue" \
            >> {output.tsv}
        """

# ===========================================================================
# Step 2: Filter BLAST results for reads with anchors
# ===========================================================================

rule filter_anchors:
    input:
        tsv = rules.blast_anchors.output.tsv
    output:
        all_matches = f"results/{BASE}/all_matches_{BASE}_blasted_{ANCHOR}.tsv",
        top_matches = f"results/{BASE}/top_matches_{BASE}_blasted_{ANCHOR}.tsv"
    params:
        base_name  = BASE,
        anchor_set = ANCHOR
    shell:
        "python scripts/filter_for_reads_with_anchors.py {params.base_name} {params.anchor_set}"

# ===========================================================================
# Step 3: Split and label reads by chromosome end
# ===========================================================================

rule split_and_label:
    input:
        tsv   = rules.filter_anchors.output.top_matches,
        fasta = FASTA_IN,
        fai   = f"{FASTA_IN}.fai"
    output:
        reads = expand(
            f"results/{BASE}/chr_anchor_included_individual_files/{BASE}_blasted_{ANCHOR}_{{cs}}_anchor_reads.fasta",
            cs=CHROM_ENDS,
        )
    params:
        base_name  = BASE,
        anchor_set = ANCHOR
    shell:
        """
        python scripts/split_and_label_all_reads_include_anchor.py {params.base_name} {params.anchor_set}

        # Ensure all expected output files exist (some chr ends may have no reads)
        for f in {output.reads}; do
            [ -f "$f" ] || touch "$f"
        done
        """

# ===========================================================================
# Step 4: Concatenate all chromosome FASTA files
# ===========================================================================

rule aggregate_chromosomes:
    input:
        reads = rules.split_and_label.output.reads
    output:
        merged = f"results/{BASE}/{BASE}_all_chromosome_anchored_reads_pre_trim.fasta"
    shell:
        "cat {input.reads} > {output.merged}"

# ===========================================================================
# Step 5: Porechop adapter trimming
# ===========================================================================

rule porechop_trim:
    input:
        fasta    = rules.aggregate_chromosomes.output.merged,
        adapters = config["references"]["adapters"]
    output:
        fastq = f"results/{BASE}/porechop_trim/all_chromosome_anchored_read_trimmed.fastq",
        fasta = f"results/{BASE}/porechop_trim/all_chromosome_anchored_read_trimmed.fasta",
        log   = f"results/{BASE}/{BASE}_all_chrs_split_to_telomere_porechopped.log"
    threads: workflow.cores
    shell:
        """
        mkdir -p results/{BASE}/porechop_trim/
        porechop_abi -t {threads} --format fastq -ddb -v 3 --no_split \
            -cap {input.adapters} -i {input.fasta} \
            -o {output.fastq} > {output.log}

        sed -n '1~4s/^@/>/p;2~4p' {output.fastq} > {output.fasta}
        """

# ===========================================================================
# Step 6a: Parse Porechop log
# ===========================================================================

rule parse_porechop_log:
    input:
        log = rules.porechop_trim.output.log
    output:
        tsv = f"results/{BASE}/{BASE}_porechopped.tsv"
    params:
        base_name = BASE
    shell:
        "python scripts/check_for_adapters.py {params.base_name} {input.log}"

# ===========================================================================
# Step 6b: Create sequencing summary
# ===========================================================================

rule sequence_summary:
    input:
        fasta = FASTA_IN
    output:
        summary = f"results/{BASE}/{BASE}_sequencing_summary.tsv"
    params:
        base_name = BASE
    shell:
        "python scripts/make_summary_file_for_comparison.py {params.base_name}"

# ===========================================================================
# Step 6c: Compare adapter callers (QC)
# ===========================================================================

rule compare_callers:
    input:
        summary   = rules.sequence_summary.output.summary,
        porechop  = rules.parse_porechop_log.output.tsv,
        blast_raw = rules.blast_anchors.output.tsv,
        blast_top = rules.filter_anchors.output.top_matches
    output:
        stats = f"results/{BASE}/{BASE}_adapter_trimming_check.stats",
        table = f"results/{BASE}/{BASE}_adapter_trimming_check.tsv"
    params:
        base_name  = BASE,
        anchor_set = ANCHOR
    shell:
        "python scripts/compare_adapter_callers_dorado.py {params.base_name} {params.anchor_set}"

# ===========================================================================
# Step 7: Fine telomere trimming
# ===========================================================================

rule fine_trimming:
    input:
        fasta        = rules.aggregate_chromosomes.output.merged,
        adapter_info = rules.compare_callers.output.table,
        best_anchor  = rules.filter_anchors.output.top_matches
    output:
        main_tsv = f"results/{BASE}/{BASE}_post_telo_trimming.tsv",
        trim_dir = directory(f"results/{BASE}/repeat_trim_files/")
    params:
        base_name  = BASE,
        anchor_set = ANCHOR
    shell:
        "python scripts/fine_telomere_trimming.py {params.base_name} {params.anchor_set}"

# ===========================================================================
# Step 8a: BLAST anchored reads for Y prime probe (per chr end)
# ===========================================================================

rule blast_y_primes:
    input:
        query = f"{CHR_ANCHOR_DIR}/{BASE}_blasted_{ANCHOR}_chr{{cs}}_anchor_reads.fasta",
        db    = config["references"]["probe"]
    output:
        tsv = f"{Y_PRIME_BLAST_PROBE_DIR}/{BASE}_{{cs}}_anchor_reads_blasted_probe.tsv"
    threads: workflow.cores
    shell:
        """
        mkdir -p {Y_PRIME_BLAST_PROBE_DIR}
        echo -e "read_id\\ttotal_read_length\\tread_bp_used_for_match\\tmatch_start_on_read\\tmatch_end_on_read\\tanchor_name\\ttotal_anchor_length\\tmatch_start_on_anchor\\tmatch_end_on_anchor\\tpident\\tbitscore\\tevalue" > {output.tsv}

        blastn -query {input.query} -db {input.db} -perc_identity 90 -num_threads {threads} \
            -outfmt "6 qseqid qlen length qstart qend sseqid slen sstart send pident bitscore evalue" \
            >> {output.tsv}
        """

# ===========================================================================
# Step 8b: Y prime analysis
# ===========================================================================

rule y_prime_analysis:
    input:
        best_anchor  = rules.filter_anchors.output.top_matches,
        telo_results = rules.fine_trimming.output.main_tsv,
        probe_blasts = expand(
            f"{Y_PRIME_BLAST_PROBE_DIR}/{BASE}_{{cs}}_anchor_reads_blasted_probe.tsv",
            cs=BLAST_CS,
        )
    output:
        main_tsv       = f"results/outputs/{BASE}_post_y_prime_probe.tsv",
        combined_probe = f"{Y_PRIME_BLAST_PROBE_DIR}/all_{BASE}_probe_matches.tsv",
        stats          = f"results/{BASE}/{BASE}_stats_y_prime.txt"
    params:
        base_name  = BASE,
        anchor_set = ANCHOR
    shell:
        """
        mkdir -p results/outputs/ figures_for_y_primes/
        python scripts/y_prime_analysis.py {params.base_name} {params.anchor_set}
        """

# ===========================================================================
# Step 9: Combined telomere plots
# ===========================================================================

rule combined_plot:
    input:
        y_prime_tsv = rules.y_prime_analysis.output.main_tsv
    output:
        done = touch(f"results/{BASE}/.combined_plot_done")
    params:
        base_name = BASE
    shell:
        """
        mkdir -p results/outputs/
        python scripts/combined_plot_telomeres.py {params.base_name} {input.y_prime_tsv} results/outputs/
        """

# ===========================================================================
# Step 10: minimap2 alignment — one job per chr end
# ===========================================================================

rule recombination_alignment:
    """
    Align per-chr-end reads against the day0 reference.
    Produces breakpoints TSV, diverged tails FASTA, and sorted indexed BAM.
    """
    input:
        reads    = f"{CHR_ANCHOR_DIR}/{BASE}_blasted_{ANCHOR}_{{chr_end}}_anchor_reads.fasta",
        day0_ref = DAY0_REF,
        day0_bed = DAY0_BED,
    output:
        tsv   = f"{RECOMB_DIR}/{BASE}_{{chr_end}}_breakpoints.tsv",
        bam   = f"{RECOMB_DIR}/{BASE}_{{chr_end}}.bam",
        tails = f"{RECOMB_DIR}/{BASE}_{{chr_end}}_diverged_tails.fasta",
    params:
        chr_end = "{chr_end}",
    threads: workflow.cores
    shell:
        """
        mkdir -p {RECOMB_DIR}
        python scripts/run_alignment.py \
            --reads-fasta {input.reads} \
            --day0-ref    {input.day0_ref} \
            --day0-bed    {input.day0_bed} \
            --chr-end     {params.chr_end} \
            --output-tsv  {output.tsv} \
            --output-bam  {output.bam} \
            --threads     {threads}
        """

# ===========================================================================
# Step 11: Combined feature analysis — one job per chr end
# ===========================================================================

rule recombination_analyze:
    """
    Combined feature analysis: batch preprocessing (RepeatMasker + BLAST)
    then per-read structural walk from anchor → spacer → X element → Y primes → telomere.
    Replaces the previous 3 separate rules (y_prime, x_prime, spacer) + aggregation.
    """
    input:
        breakpoints     = f"{RECOMB_DIR}/{BASE}_{{chr_end}}_breakpoints.tsv",
        reads           = f"{CHR_ANCHOR_DIR}/{BASE}_blasted_{ANCHOR}_{{chr_end}}_anchor_reads.fasta",
        diverged        = f"{RECOMB_DIR}/{BASE}_{{chr_end}}_diverged_tails.fasta",
        day0_bed        = DAY0_BED,
        y_prime_lib     = Y_PRIME_LIB,
    output:
        tsv = f"{RECOMB_DIR}/{BASE}_{{chr_end}}_features.tsv",
    params:
        chr_end         = "{chr_end}",
        strain          = STRAIN,
        spacer_lib_dir  = SPACER_LIB_DIR,
        x_elem_lib_dir  = X_ELEM_LIB_DIR,
    threads: workflow.cores
    shell:
        """
        python scripts/analyze_features.py \
            --breakpoints-tsv   {input.breakpoints} \
            --reads-fasta       {input.reads} \
            --diverged-fasta    {input.diverged} \
            --day0-bed          {input.day0_bed} \
            --y-prime-lib       {input.y_prime_lib} \
            --spacer-lib-dir    {params.spacer_lib_dir} \
            --x-element-lib-dir {params.x_elem_lib_dir} \
            --chr-end           {params.chr_end} \
            --strain            {params.strain} \
            --output-tsv        {output.tsv} \
            --threads           {threads}
        """

# ===========================================================================
# Step 12: Cross-chr-end summary
# ===========================================================================

rule recombination_summary_tsv:
    """
    Aggregate all per-chr-end features TSVs into a single
    summary TSV with per-chr-end statistics.
    """
    input:
        expand(
            f"{RECOMB_DIR}/{BASE}_{{chr_end}}_features.tsv",
            chr_end=CHROM_ENDS,
        )
    output:
        tsv = f"{RECOMB_DIR}/{BASE}_recombination_summary.tsv",
    params:
        recomb_dir = RECOMB_DIR,
        base_name  = BASE,
    shell:
        """
        python scripts/aggregate_recombination.py --summarize \
            --recombination-dir {params.recomb_dir} \
            --base-name         {params.base_name} \
            --output-summary    {output.tsv}
        """
