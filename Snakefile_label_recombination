"""
Snakefile_label_recombination: Labeling and Recombination Detection Pipeline

This pipeline takes a polished reference genome (from Snakefile_create_ref) and
raw sequencing reads, then:
1. Labels pretelomeric features (anchors, Y primes, X primes) in the reference
2. Detects recombination events by comparing features to the 6991 reference
3. Analyzes individual reads for recombination patterns

The labeling and recombination detection are integrated - as features are labeled,
their source chromosome end (from 6991) is tracked to identify recombination events.

Steps:
1. Label reference features with recombination detection
2. Extract Y prime sequences for RepeatMasker library
3. Process reads (BLAST anchors, split by chromosome, trim)
4. Y prime probe analysis
5. RepeatMasker Y prime analysis
6. Calculate recombination statistics

Usage:
    snakemake -s Snakefile_label_recombination --configfile config_label_recombination.yaml -c <cores>
"""

import os
import glob

# Load configuration
configfile: "config_label_recombination.yaml"

# Variables from config
BASE = config["base_name"]
STRAIN = config["strain"]
ANCHOR = config["anchor_set"]

# Input paths
# Reference from create_ref pipeline (or any polished reference)
REFERENCE_FASTA = config["reference_fasta"]

# Input format for reads: "bam", "fasta", or "fastq"
INPUT_FORMAT = config.get("input_format", "bam").lower()

# Input path for reads
if INPUT_FORMAT == "bam":
    INPUT_FILE = config.get("input_path", "")
elif INPUT_FORMAT == "fasta":
    INPUT_FILE = config.get("input_path", "")
elif INPUT_FORMAT == "fastq":
    INPUT_FILE = config.get("input_path", "")
else:
    raise ValueError(f"Invalid input_format: {INPUT_FORMAT}. Must be 'bam', 'fasta', or 'fastq'")

# Output directories
RESULTS_DIR = f"results/{BASE}"
LABELS_DIR = f"{RESULTS_DIR}/pretelomeric_labels"

# Define output paths for FASTA and FASTQ (used by downstream rules)
FASTA_IN = f"{RESULTS_DIR}/{BASE}.fasta"
FASTQ_IN = f"{RESULTS_DIR}/{BASE}.fastq"

# Define the 16 yeast chromosomes and their two sides (L and R)
CHROMS = [str(i) for i in range(1, 17)]
SIDES = ["L", "R"]
CHROM_SIDES = [f"chr{c}{s}" for c in CHROMS for s in SIDES]

# Labeling parameters
MIN_PIDENT = config.get("min_pident", 75.0)
MIN_LENGTH = config.get("min_length", 100)
EVALUE = config.get("evalue", "1e-5")

# Paths to Y prime library (generated by labeling step)
REPEATMASKER_YPRIMES_FASTA = f"{LABELS_DIR}/extracted_yprimes_{STRAIN}.fasta"
FEATURES_BED = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}_simp.bed"

rule all:
    input:
        # Labeling outputs
        f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}.gff3",
        f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}.bed",
        f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}_simp.bed",
        f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}.tsv",
        f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}_recombination.tsv",
        REPEATMASKER_YPRIMES_FASTA,
        # Read analysis outputs
        f"{RESULTS_DIR}/{BASE}_post_y_prime_probe.tsv",
        f"{RESULTS_DIR}/{BASE}_stats_y_prime.txt",
        f"{RESULTS_DIR}/y_prime_blast/all_{BASE}_probe_matches.tsv",
        directory(f"{RESULTS_DIR}/figures_for_y_primes"),
        f"{RESULTS_DIR}/{BASE}_y_prime_recombination.tsv"

# ============================================================================
# Phase 1: Label Reference Features with Recombination Detection
# ============================================================================

rule label_pretelomeric_regions:
    input:
        reference = REFERENCE_FASTA,
        anchors = config["references"]["anchors"],
        yprimes = config["references"]["yprimes_6991"],
        xprimes = config["references"].get("xprimes_6991", ""),
        probe = config["references"].get("probe", "")
    output:
        gff3 = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}.gff3",
        bed = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}.bed",
        bed_simp = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}_simp.bed",
        tsv = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}.tsv",
        recomb = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}_recombination.tsv",
        structure = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}_structure.txt",
        anchor_blast = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}_anchor_blast.txt",
        yprime_blast = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}_yprime_blast.txt"
    params:
        output_dir = LABELS_DIR,
        prefix = f"pretelomeric_regions_{STRAIN}",
        min_pident = MIN_PIDENT,
        min_length = MIN_LENGTH,
        evalue = EVALUE,
        xprime_arg = lambda wildcards, input: f"--xprimes {input.xprimes}" if input.xprimes and os.path.exists(input.xprimes) else "",
        probe_arg = lambda wildcards, input: f"--probe {input.probe}" if input.probe and os.path.exists(input.probe) else ""
    threads: workflow.cores
    shell:
        """
        mkdir -p {params.output_dir}

        python scripts/label_and_detect_recombination.py \
            --reference {input.reference} \
            --anchors {input.anchors} \
            --yprimes {input.yprimes} \
            --output-dir {params.output_dir} \
            --prefix {params.prefix} \
            --threads {threads} \
            --min-pident {params.min_pident} \
            --min-length {params.min_length} \
            --evalue {params.evalue} \
            {params.xprime_arg} \
            {params.probe_arg}
        """

rule extract_yprime_fasta:
    input:
        tsv = f"{LABELS_DIR}/pretelomeric_regions_{STRAIN}.tsv",
        reference = REFERENCE_FASTA
    output:
        fasta = REPEATMASKER_YPRIMES_FASTA
    params:
        strain = STRAIN
    shell:
        """
        python scripts/extract_yprime_fasta.py \
            --labeled-tsv {input.tsv} \
            --reference {input.reference} \
            --output {output.fasta} \
            --strain {params.strain}
        """

# ============================================================================
# Phase 2: Prepare Reads for Analysis
# ============================================================================

# Handle input format conversion based on config
if INPUT_FORMAT == "bam":
    # Convert BAM to FASTA and FASTQ
    rule prep_from_bam:
        input:
            bam = INPUT_FILE
        output:
            fastq = FASTQ_IN,
            fasta = FASTA_IN
        threads: 16
        shell:
            """
            mkdir -p {RESULTS_DIR}
            samtools fastq -@ {threads} -T '*' {input.bam} > {output.fastq}
            seqtk seq -A {output.fastq} > {output.fasta}
            """

elif INPUT_FORMAT == "fastq":
    # Convert FASTQ to FASTA (and copy/link FASTQ to results dir)
    rule prep_from_fastq:
        input:
            fastq = INPUT_FILE
        output:
            fastq = FASTQ_IN,
            fasta = FASTA_IN
        shell:
            """
            mkdir -p {RESULTS_DIR}
            # Copy or link FASTQ to results directory
            if [ "{input.fastq}" != "{output.fastq}" ]; then
                cp {input.fastq} {output.fastq}
            fi
            # Convert FASTQ to FASTA
            seqtk seq -A {input.fastq} > {output.fasta}
            """

elif INPUT_FORMAT == "fasta":
    # Copy/link FASTA to results dir
    rule prep_from_fasta:
        input:
            fasta = INPUT_FILE
        output:
            fasta = FASTA_IN
        shell:
            """
            mkdir -p {RESULTS_DIR}
            # Copy or link FASTA to results directory
            if [ "{input.fasta}" != "{output.fasta}" ]; then
                cp {input.fasta} {output.fasta}
            fi
            """

    # Create a dummy FASTQ from FASTA (needed for porechop)
    rule fasta_to_fastq:
        input:
            fasta = FASTA_IN
        output:
            fastq = FASTQ_IN
        shell:
            """
            # Convert FASTA to FASTQ with dummy quality scores (all 'I' = Q40)
            seqtk seq -F 'I' {input.fasta} > {output.fastq}
            """

rule index_fasta:
    input:
        fasta = FASTA_IN
    output:
        fai = f"{FASTA_IN}.fai"
    shell:
        "samtools faidx {input.fasta}"

# ============================================================================
# Phase 3: BLAST for Reads with Anchors
# ============================================================================

rule blast_anchors:
    input:
        query = FASTA_IN,
        db = config["references"]["anchors"]
    output:
        tsv = f"{RESULTS_DIR}/{BASE}_blasted_{ANCHOR}.tsv"
    threads: workflow.cores
    shell:
        """
        echo -e "read_id\\ttotal_read_length\\tread_bp_used_for_match\\tmatch_start_on_read\\tmatch_end_on_read\\tanchor_name\\ttotal_anchor_length\\tmatch_start_on_anchor\\tmatch_end_on_anchor\\tpident\\tbitscore\\tevalue" > {output.tsv}

        blastn -query {input.query} -db {input.db} -task megablast \
            -perc_identity 85 -min_raw_gapped_score 3000 -num_threads {threads} \
            -outfmt "6 qseqid qlen length qstart qend sseqid slen sstart send pident bitscore evalue" \
            >> {output.tsv}
        """

rule filter_anchors:
    input:
        tsv = rules.blast_anchors.output.tsv
    output:
        all_matches = f"{RESULTS_DIR}/all_matches_{BASE}_blasted_{ANCHOR}.tsv",
        top_matches = f"{RESULTS_DIR}/top_matches_{BASE}_blasted_{ANCHOR}.tsv"
    shell:
        "python scripts/filter_for_reads_with_anchors.py {input.tsv} {output.all_matches} {output.top_matches}"

rule split_and_label:
    input:
        tsv = rules.filter_anchors.output.top_matches,
        fasta = FASTA_IN,
        fai = f"{FASTA_IN}.fai"
    output:
        reads = expand("{results_dir}/chr_anchor_included_individual_files/{base}_blasted_{anchor}_{cs}_anchor_reads.fasta",
                       results_dir=RESULTS_DIR, base=BASE, anchor=ANCHOR, cs=CHROM_SIDES)
    params:
        outdir = f"{RESULTS_DIR}/chr_anchor_included_individual_files/"
    shell:
        """
        mkdir -p {params.outdir}
        python scripts/split_and_label_all_reads_include_anchor.py {input.tsv} {input.fasta} {params.outdir} {BASE} {ANCHOR}
        """

rule aggregate_chromosomes:
    input:
        reads = expand("{results_dir}/chr_anchor_included_individual_files/{base}_blasted_{anchor}_{cs}_anchor_reads.fasta",
                       results_dir=RESULTS_DIR, base=BASE, anchor=ANCHOR, cs=CHROM_SIDES)
    output:
        merged = f"{RESULTS_DIR}/{BASE}_all_chromosome_anchored_reads_pre_trim.fasta"
    shell:
        "cat {input.reads} > {output.merged}"

# ============================================================================
# Phase 4: Trim and Process Reads
# ============================================================================

rule porechop_trim:
    input:
        fasta = rules.aggregate_chromosomes.output.merged,
        adapters = config["references"]["adapters"]
    output:
        fastq = f"{RESULTS_DIR}/porechop_trim/all_chromosome_anchored_read_trimmed.fastq",
        fasta = f"{RESULTS_DIR}/porechop_trim/all_chromosome_anchored_read_trimmed.fasta",
        log = f"{RESULTS_DIR}/{BASE}_all_chrs_split_to_telomere_porechopped.log"
    threads: workflow.cores
    shell:
        """
        porechop_abi -t {threads} --format fastq -ddb -v 3 --no_split \
            -cap {input.adapters} -i {input.fasta} \
            -o {output.fastq} > {output.log}

        sed -n '1~4s/^@/>/p;2~4p' {output.fastq} > {output.fasta}
        """

rule sequence_summary:
    input:
        fasta = FASTA_IN
    output:
        summary = f"{RESULTS_DIR}/{BASE}_sequencing_summary.tsv"
    shell:
        """
        echo -e "read_id\\tsequence_length_template" > {output.summary}
        seqkit fx2tab -n -l -i {input.fasta} >> {output.summary}
        """

rule parse_porechop_log:
    input:
        log = f"{RESULTS_DIR}/{BASE}_all_chrs_split_to_telomere_porechopped.log"
    output:
        tsv = f"{RESULTS_DIR}/{BASE}_porechopped_results.tsv"
    shell:
        "python scripts/check_for_adapters.py {BASE} {input.log} {output.tsv}"

rule compare_callers:
    input:
        summary = rules.sequence_summary.output.summary,
        porechop = rules.parse_porechop_log.output.tsv,
        blast_raw = f"{RESULTS_DIR}/{BASE}_blasted_{ANCHOR}.tsv",
        blast_top = f"{RESULTS_DIR}/top_matches_{BASE}_blasted_{ANCHOR}.tsv"
    output:
        stats = f"{RESULTS_DIR}/{BASE}_adapter_trimming_check.stats",
        table = f"{RESULTS_DIR}/{BASE}_adapter_trimming_check.tsv"
    shell:
        """
        python scripts/compare_adapter_callers_dorado.py \
            {input.summary} \
            {input.porechop} \
            {input.blast_raw} \
            {input.blast_top} \
            {output.stats} \
            {output.table} \
            {ANCHOR}
        """

rule index_merged_fasta:
    input:
        rules.aggregate_chromosomes.output.merged
    output:
        fai = f"{rules.aggregate_chromosomes.output.merged}.fai"
    shell:
        "samtools faidx {input}"

rule fine_trimming:
    input:
        fasta = rules.aggregate_chromosomes.output.merged,
        fai = f"{rules.aggregate_chromosomes.output.merged}.fai",
        adapter_info = rules.compare_callers.output.table,
        best_anchor = f"{RESULTS_DIR}/top_matches_{BASE}_blasted_{ANCHOR}.tsv"
    output:
        main_tsv = f"{RESULTS_DIR}/{BASE}_post_telo_trimming.tsv",
        fasta_trimmed = f"{RESULTS_DIR}/{BASE}_fine_trimmed.fasta",
        trim_dir = directory(f"{RESULTS_DIR}/repeat_trim_files/")
    shell:
        """
        mkdir -p {output.trim_dir}
        python scripts/fine_telomere_trimming.py \
            {input.fasta} \
            {input.adapter_info} \
            {input.best_anchor} \
            {output.main_tsv} \
            {output.trim_dir} \
            {BASE} \
            {output.fasta_trimmed}
        """

# ============================================================================
# Phase 5: Y Prime Analysis
# ============================================================================

rule blast_y_primes:
    input:
        query = f"{RESULTS_DIR}/chr_anchor_included_individual_files/{BASE}_blasted_{ANCHOR}_{{chrom_side}}_anchor_reads.fasta",
        db = config["references"]["probe"]
    output:
        tsv = f"{RESULTS_DIR}/y_prime_blast/{BASE}_{{chrom_side}}_blasted_probe.tsv"
    threads: 4
    shell:
        """
        echo -e "read_id\\ttotal_read_length\\tread_bp_used_for_match\\tmatch_start_on_read\\tmatch_end_on_read\\tanchor_name\\ttotal_anchor_length\\tmatch_start_on_anchor\\tmatch_end_on_anchor\\tpident\\tbitscore\\tevalue" > {output.tsv}

        blastn -query {input.query} -db {input.db} -perc_identity 90 -num_threads {threads} \
            -outfmt "6 qseqid qlen length qstart qend sseqid slen sstart send pident bitscore evalue" \
            >> {output.tsv}
        """

rule y_prime_analysis:
    input:
        best_anchor = f"{RESULTS_DIR}/top_matches_{BASE}_blasted_{ANCHOR}.tsv",
        telo_results = f"{RESULTS_DIR}/{BASE}_post_telo_trimming.tsv",
        probe_blasts = expand("{results_dir}/y_prime_blast/{base}_{chrom_side}_blasted_probe.tsv",
                             results_dir=RESULTS_DIR, base=BASE, chrom_side=CHROM_SIDES)
    output:
        main_tsv = f"{RESULTS_DIR}/{BASE}_post_y_prime_probe.tsv",
        stats = f"{RESULTS_DIR}/{BASE}_stats_y_prime.txt",
        combined_probe = f"{RESULTS_DIR}/y_prime_blast/all_{BASE}_probe_matches.tsv",
        figures = directory(f"{RESULTS_DIR}/figures_for_y_primes")
    params:
        base_name = BASE,
        anchor_set = ANCHOR,
        probe_dir = f"{RESULTS_DIR}/y_prime_blast"
    shell:
        """
        python scripts/y_prime_analysis.py {params.base_name} {params.anchor_set} \
            --top-anchor-blast {input.best_anchor} \
            --telomere-repeat-results {input.telo_results} \
            --probe-blast-dir {params.probe_dir} \
            --output-tsv {output.main_tsv} \
            --output-stats {output.stats} \
            --figure-dir {output.figures} \
            --combined-probe-output {output.combined_probe}
        """

# ============================================================================
# Phase 6: RepeatMasker Y Prime Analysis
# ============================================================================

rule repeatmasker_y_primes:
    input:
        query = f"{RESULTS_DIR}/chr_anchor_included_individual_files/{BASE}_blasted_{ANCHOR}_{{chrom_side}}_anchor_reads.fasta",
        database = REPEATMASKER_YPRIMES_FASTA
    output:
        out_file = f"{RESULTS_DIR}/read_repeatmasker_results/{BASE}_blasted_{ANCHOR}_{{chrom_side}}_anchor_reads.fasta.out",
        filtered = f"{RESULTS_DIR}/read_repeatmasker_results/{BASE}_{ANCHOR}_{{chrom_side}}_filtered.out",
        ssv = f"{RESULTS_DIR}/read_repeatmasker_results/{BASE}_{ANCHOR}_{{chrom_side}}_repeatmasker_results.ssv"
    params:
        outdir = f"{RESULTS_DIR}/read_repeatmasker_results/"
    threads: 12
    shell:
        """
        mkdir -p {params.outdir}

        RepeatMasker {input.query} -lib {input.database} -s -pa {threads} \
            --cutoff 1000 -no_is -norna -gff -dir {params.outdir}

        echo -e "SW_score\\tdivergence_percent\\tdeletion_percent\\tinsertion_percent\\tread_id\\tmatch_start_on_read\\tmatch_end_on_read\\tleftover_on_read\\tstrand\\ty_prime_id\\ty_prime_group\\tmatch_start_on_y_prime\\tmatch_end_on_y_prime\\tleftover_on_y_prime\\tmatch_id\\tsub_match" > {output.ssv}

        grep "Y_Prime" {output.out_file} > {output.filtered} || touch {output.filtered}
        cat {output.filtered} >> {output.ssv}
        """

rule aggregate_repeatmasker_y_primes:
    input:
        expand("{results_dir}/read_repeatmasker_results/{base}_{anchor}_{chrom_side}_repeatmasker_results.ssv",
               results_dir=RESULTS_DIR, base=BASE, anchor=ANCHOR, chrom_side=CHROM_SIDES)
    output:
        marker = touch(f"{RESULTS_DIR}/read_repeatmasker_results/.done")
    shell:
        "echo 'All RepeatMasker Y prime jobs complete'"

rule make_y_prime_repeatmasker_tsv:
    input:
        repeatmasker_done = f"{RESULTS_DIR}/read_repeatmasker_results/.done",
        y_prime_probe = f"{RESULTS_DIR}/{BASE}_post_y_prime_probe.tsv"
    output:
        all_repeatmasker = f"{RESULTS_DIR}/{BASE}_repeatmasker.tsv",
        good_end = f"{RESULTS_DIR}/{BASE}_good_end_y_repeatmasker.tsv",
        gained_y = f"{RESULTS_DIR}/{BASE}_gained_y_repeatmasker.tsv"
    params:
        repeatmasker_dir = f"{RESULTS_DIR}/read_repeatmasker_results/"
    shell:
        """
        python scripts/make_y_prime_repeatmasker_tsv.py \
            {params.repeatmasker_dir} \
            {input.y_prime_probe} \
            {output.all_repeatmasker} \
            {output.good_end} \
            {output.gained_y}
        """

# ============================================================================
# Phase 7: Recombination Statistics
# ============================================================================

rule get_stats_of_recombination:
    input:
        good_end_y = f"{RESULTS_DIR}/{BASE}_good_end_y_repeatmasker.tsv",
        y_prime_probe = f"{RESULTS_DIR}/{BASE}_post_y_prime_probe.tsv"
    output:
        recomb = f"{RESULTS_DIR}/{BASE}_y_prime_recombination.tsv"
    params:
        strain = STRAIN
    shell:
        """
        python scripts/get_stats_of_recombination.py \
            {input.good_end_y} \
            {input.y_prime_probe} \
            {params.strain} \
            {output.recomb}
        """

# ============================================================================
# Optional: Y Prime Pairing Analysis
# ============================================================================

checkpoint make_pairings_from_y_primes_all_ends:
    input:
        good_end_y = f"{RESULTS_DIR}/{BASE}_good_end_y_repeatmasker.tsv",
        chr_reads = expand("{results_dir}/chr_anchor_included_individual_files/{base}_blasted_{anchor}_{cs}_anchor_reads.fasta",
                          results_dir=RESULTS_DIR, base=BASE, anchor=ANCHOR, cs=CHROM_SIDES)
    output:
        pairings_dir = directory(f"{RESULTS_DIR}/paired_by_y_prime_reads/")
    params:
        strain = STRAIN,
        anchor = ANCHOR,
        base_name = BASE
    shell:
        """
        mkdir -p {output.pairings_dir}
        python scripts/make_pairings_from_y_primes_all_ends.py \
            {input.good_end_y} \
            {RESULTS_DIR}/chr_anchor_included_individual_files/ \
            {output.pairings_dir} \
            {params.strain} \
            {params.anchor} \
            {params.base_name}
        """

def get_pairing_names(wildcards):
    """Get list of pairing file basenames (without .fasta extension) from checkpoint"""
    checkpoint_output = checkpoints.make_pairings_from_y_primes_all_ends.get(**wildcards).output.pairings_dir
    pairing_files = glob.glob(f"{checkpoint_output}/*.fasta")
    return [os.path.basename(f).replace('.fasta', '') for f in pairing_files]

# ============================================================================
# Optional: X Element Analysis (requires reference pairings)
# ============================================================================

rule repeatmasker_x_elements:
    input:
        query = f"{RESULTS_DIR}/paired_by_y_prime_reads/{{pairing}}.fasta",
        database = f"references/pairings_for_x_element_ends/{STRAIN}_pairings/{STRAIN}_paired_{{pairing}}.fasta"
    output:
        out_file = f"{RESULTS_DIR}/paired_x_element_ends_repeatmasker_results/{{pairing}}.fasta.out",
        filtered = f"{RESULTS_DIR}/paired_x_element_ends_repeatmasker_results/{{pairing}}_x_element_ends_filtered.out",
        ssv = f"{RESULTS_DIR}/paired_x_element_ends_repeatmasker_results/{BASE}_{{pairing}}_x_element_ends_repeatmasker_results.ssv"
    params:
        outdir = f"{RESULTS_DIR}/paired_x_element_ends_repeatmasker_results/"
    threads: 12
    shell:
        """
        mkdir -p {params.outdir}

        RepeatMasker {input.query} -lib {input.database} -s -pa {threads} \
            --cutoff 500 -no_is -norna -gff -dir {params.outdir}

        echo -e "SW_score\\tdivergence_percent\\tdeletion_percent\\tinsertion_percent\\tread_id\\tmatch_start_on_read\\tmatch_end_on_read\\tleftover_on_read\\tstrand\\tx_element_ends\\tsection_number\\tmatch_start_on_chr_end_section\\tmatch_end_on_chr_end_section\\tleftover_on_chr_end_section\\tmatch_id\\tsub_match" > {output.ssv}

        grep "x_ends" {output.out_file} > {output.filtered} || touch {output.filtered}
        cat {output.filtered} >> {output.ssv}
        """

# ============================================================================
# Optional: Spacer Analysis (requires reference pairings)
# ============================================================================

rule repeatmasker_spacers:
    input:
        query = f"{RESULTS_DIR}/paired_by_y_prime_reads/{{pairing}}.fasta",
        database = f"references/pairings_for_spacers/{STRAIN}_pairings/{STRAIN}_paired_{{pairing}}.fasta"
    output:
        out_file = f"{RESULTS_DIR}/paired_spacer_repeatmasker_results/{{pairing}}.fasta.out",
        filtered = f"{RESULTS_DIR}/paired_spacer_repeatmasker_results/{{pairing}}_spacer_filtered.out",
        ssv = f"{RESULTS_DIR}/paired_spacer_repeatmasker_results/{BASE}_{{pairing}}_spacer_repeatmasker_results.ssv"
    params:
        outdir = f"{RESULTS_DIR}/paired_spacer_repeatmasker_results/"
    threads: 12
    shell:
        """
        mkdir -p {params.outdir}

        RepeatMasker {input.query} -lib {input.database} -s -pa {threads} \
            --cutoff 500 -no_is -norna -gff -dir {params.outdir}

        echo -e "SW_score\\tdivergence_percent\\tdeletion_percent\\tinsertion_percent\\tread_id\\tmatch_start_on_read\\tmatch_end_on_read\\tleftover_on_read\\tstrand\\tchr_end_tract\\tsection_number\\tmatch_start_on_chr_end_section\\tmatch_end_on_chr_end_section\\tleftover_on_chr_end_section\\tmatch_id\\tsub_match" > {output.ssv}

        grep "_from_repeat_to_plus_50kb" {output.out_file} > {output.filtered} || touch {output.filtered}
        cat {output.filtered} >> {output.ssv}
        """

rule make_spacer_pairs_repeatmasker_tsv:
